#!/usr/bin/with-contenv bashio
set -Eeuo pipefail

mkdir -p /config/cups /run/dbus /run/cups /var/cache/cups /var/log/cups /var/spool/cups

id epson >/dev/null 2>&1 || useradd --system --no-create-home --shell /usr/sbin/nologin --groups lpadmin epson
password="$(bashio::config 'admin_password')"
if [ -n "$password" ]; then
  printf 'epson:%s\n' "$password" | chpasswd
  bashio::log.info "CUPS administration uses the epson account and configured app password"
else
  passwd --lock epson >/dev/null
  bashio::log.warning "Set admin_password in app Configuration to enable authenticated CUPS administration"
fi
unset password

MIGRATION_CUPS=/share/epson-scan/cups-migration/local_cupsik/cups
if [ -f "$MIGRATION_CUPS/printers.conf" ] && [ ! -e /config/cups/printers.conf ]; then
  bashio::log.info "Migrating the preserved Epson CUPS configuration"
  cp -a "$MIGRATION_CUPS"/. /config/cups/
fi

if [ -f /config/cups/printers.conf ]; then
  bashio::log.info "Using the persistent Epson CUPS queue configuration"
else
  bashio::log.warning "No persistent printers.conf is available yet"
fi

if [ ! -f /config/cups/cupsd.conf ]; then
  cp -a /etc/cups/. /config/cups/
fi
if [ -f /config/printers.conf ] && [ ! -f /config/cups/printers.conf ]; then
  cp -a /config/printers.conf /config/cups/printers.conf
fi

if [ -L /etc/cups ]; then
  unlink /etc/cups
elif [ -d /etc/cups ] && [ ! -d /etc/cups.defaults ]; then
  mv /etc/cups /etc/cups.defaults
fi
ln -s /config/cups /etc/cups

chown -R lp:lp /var/cache/cups /var/log/cups /var/spool/cups /run/cups || true

exec sleep infinity
