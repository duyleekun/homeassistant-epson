#!/usr/bin/with-contenv bashio
set -u

last_state=unknown

scanner_present() {
  lsusb -d 04b8:1188 >/dev/null 2>&1
}

refresh_native_backend() {
  local output
  output="$(timeout 45s epsonscan2 --get-status 2>&1 || true)"
  bashio::log.info "Epson Scan 2 USB state changed; refreshed native backend"
  printf '%s\n' "$output" | sed -n '1,40p'
}

panel_listener_enabled() {
  [ ! -e /share/epson-scan/panel-listener.disabled ]
}

while true; do
  if scanner_present; then
    state=present
  else
    state=absent
  fi

  if [ "$state" != "$last_state" ]; then
    if [ "$state" = present ]; then
      python3 /usr/local/bin/epson_status.py --connected true --state idle || true
      if panel_listener_enabled; then
        bashio::log.info "Panel listener owns Epson USB interface; skipping concurrent Epson Scan 2 refresh"
      else
        refresh_native_backend
      fi
    else
      python3 /usr/local/bin/epson_status.py --connected false --state offline || true
      bashio::log.info "Epson scanner USB device is absent"
    fi
    last_state="$state"
  fi
  sleep 5
done
